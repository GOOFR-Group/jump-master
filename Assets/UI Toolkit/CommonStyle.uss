.text-shadow {
    text-shadow: 1.2px 1.2px 2px rgba(0, 0, 0, 0.8);
}

.button {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(220, 226, 231);
    font-size: 40px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/PixelifySans-SemiBold.ttf?fileID=12800000&guid=3bab60800bfdc90458ca4518e2c7992f&type=3#PixelifySans-SemiBold");
    background-image: url("project://database/Assets/UI/Images/Button.png?fileID=649223268058989734&guid=948e8eb02b303bd45b7993d8c26485f2&type=3#Button_0");
    height: auto;
    width: auto;
    min-width: 320px;
    min-height: 64px;
    padding-right: 20px;
    padding-left: 20px;
    padding-top: 16px;
    padding-bottom: 32px;
}

.button:hover {
    scale: 1.1 1.1;
    transition-duration: 300ms;
    transition-timing-function: ease-out-back;
    -unity-background-image-tint-color: rgb(230, 230, 230);
    color: rgb(195, 200, 205);
}

.button-animation {
    transition-duration: 200ms;
    transition-timing-function: ease-in-back;
}

.button-animation:hover {
    transition-duration: 200ms;
    transition-timing-function: ease-out-back;
    scale: 1.1 1.1;
}
